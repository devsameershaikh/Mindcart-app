{
  "expo": {
    "name": "Mind cart",
    "slug": "mindcart",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.samappstudio.mindcart",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.samappstudio.mindcart",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 7
    },
    "extra": {
      "eas": {
        "projectId": "be3c1ca4-5e59-44a0-b580-87b843761b6f"
      }
    },
    "owner": "sameer.shaikh.dev",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "YOUR_SENTRY_ORG_SLUG",
          "project": "mindcart-app"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be3c1ca4-5e59-44a0-b580-87b843761b6f"
    }
  }
}
